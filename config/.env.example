# Fill in your library card number (login name) and PIN/password locally.
# Environment variables set in Qinglong take precedence over this file.
LIBRARY_CARD_NUMBER=
LIBRARY_PIN=
HEADLESS_MODE=true
# Qinglong's Debian Chromium and matching driver:
CHROME_BINARY=/usr/bin/chromium
CHROMEDRIVER_PATH=/usr/bin/chromedriver
